<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../CensorCore.props" />
  <ItemGroup>
    <ProjectReference Include="..\CensorCore\CensorCore.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CensorCore.Runtime</PackageId>
    <PackageDescription>Highly experimental library to enable hardware-accelerated ONNX sessions with CensorCore.</PackageDescription>
  </PropertyGroup>

  <!-- Uses the ONNX Runtime package that CensorCore references (CPU). The old per-RID DirectML/CUDA 1.12.1
       references were removed: they downgraded ONNX Runtime below what the v3 models need. CreateService falls
       back to the CPU when an execution provider is not available. -->

</Project>
